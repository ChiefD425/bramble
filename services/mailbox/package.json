{
	"name": "bramble-mailbox-server",
	"version": "0.0.0",
	"private": true,
	"license": "AGPL-3.0-only",
	"author": "Webvana Inc.",
	"description": "Store-and-forward mailbox for Bramble sync: holds sealed changes and files until every device has them.",
	"type": "module",
	"scripts": {
		"start": "node src/node/bin.ts",
		"test": "vitest run && vitest run -c vitest.workers.config.ts",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
		"cf-typegen": "wrangler types --strict-vars=false",
		"db:generate": "drizzle-kit generate"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.8",
		"@hono/zod-validator": "^0.9.1",
		"@vault/core": "workspace:*",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.18",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.10",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24.13.3",
		"drizzle-kit": "^0.31.11",
		"typescript": "^7.0.2",
		"vitest": "^4.1.12",
		"wrangler": "^4.152.0"
	}
}
