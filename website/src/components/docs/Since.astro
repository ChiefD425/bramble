---
// Text shown once a release containing `commit` is out on every target in `on`.
// See src/doc-gates.ts.
import { gateStatus, shows } from "@/doc-gates";

interface Props {
	commit: string;
	/** `all` (the default), or targets separated by commas or spaces. */
	on?: string;
}

const { commit, on } = Astro.props;
---

{shows("Since", gateStatus(commit, on).state) && <slot />}
