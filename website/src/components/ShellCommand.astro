---
/**
 * A command or address to paste, with a copy button. The button's handler reads the `pre` beside
 * it, so the two have to stay siblings.
 */
import Check from "@tabler/icons/outline/check.svg";
import Copy from "@tabler/icons/outline/copy.svg";

interface Props {
	command: string;
	class?: string;
}

const { command, class: className } = Astro.props;
---

<div class:list={["relative", className]}>
	<pre class="overflow-hidden rounded-lg border border-border/60 bg-muted/50 px-3 py-2.5 pr-11 font-mono text-[0.7rem] leading-relaxed whitespace-pre-wrap break-words text-foreground"><code>{command}</code></pre>
	<button
		type="button"
		data-copy
		aria-label="Copy to clipboard"
		class="absolute top-1.5 right-1.5 inline-flex size-7 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:ring-3 focus-visible:ring-outline/50 focus-visible:outline-none"
	>
		<span class="contents" data-copy-idle>
			<Copy class="size-4" />
		</span>
		<span class="contents" data-copy-done hidden>
			<Check class="size-4" />
		</span>
	</button>
	<span class="sr-only" role="status" data-copy-status></span>
</div>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
		const idle = button.querySelector<HTMLElement>("[data-copy-idle]");
		const done = button.querySelector<HTMLElement>("[data-copy-done]");
		const status = button.parentElement?.querySelector<HTMLElement>("[data-copy-status]");
		let revert: ReturnType<typeof setTimeout>;

		button.addEventListener("click", async () => {
			const text = button.parentElement?.querySelector("pre")?.textContent;
			// Absent outside a secure context, and a silent no-op beats a thrown error over
			// something the visitor can select and copy by hand.
			if (!text || !navigator.clipboard) return;
			try {
				await navigator.clipboard.writeText(text);
			} catch {
				return;
			}

			if (idle) idle.hidden = true;
			if (done) done.hidden = false;
			if (status) status.textContent = "Copied";
			clearTimeout(revert);
			revert = setTimeout(() => {
				if (idle) idle.hidden = false;
				if (done) done.hidden = true;
				if (status) status.textContent = "";
			}, 1600);
		});
	}
</script>
